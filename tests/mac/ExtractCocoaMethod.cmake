# Extract bounded Objective-C method bodies for headless regression fixtures.
function(ois_extract_method source_file method_name output_var)
    file(READ "${source_file}" _ois_source)
    set(_ois_marker "- (void)${method_name}")
    string(FIND "${_ois_source}" "${_ois_marker}" _ois_start)
    if(_ois_start LESS 0)
        message(FATAL_ERROR "Missing production Cocoa method: ${method_name}")
    endif()
    string(LENGTH "${_ois_marker}" _ois_marker_len)
    math(EXPR _ois_after_marker "${_ois_start} + ${_ois_marker_len}")
    string(SUBSTRING "${_ois_source}" ${_ois_after_marker} -1 _ois_remainder)
    string(FIND "${_ois_remainder}" "${_ois_marker}" _ois_duplicate)
    if(NOT _ois_duplicate LESS 0)
        message(FATAL_ERROR "Duplicate production Cocoa method: ${method_name}")
    endif()
    string(SUBSTRING "${_ois_source}" ${_ois_after_marker} -1 _ois_body_remainder)
    string(FIND "${_ois_body_remainder}" "{" _ois_open_rel)
    if(_ois_open_rel LESS 0)
        message(FATAL_ERROR "Missing body for production Cocoa method: ${method_name}")
    endif()
    math(EXPR _ois_open "${_ois_after_marker} + ${_ois_open_rel}")
    set(_ois_pos ${_ois_open})
    set(_ois_depth 0)
    string(LENGTH "${_ois_source}" _ois_length)
    while(_ois_pos LESS _ois_length)
        string(SUBSTRING "${_ois_source}" ${_ois_pos} 1 _ois_char)
        if(_ois_char STREQUAL "{")
            math(EXPR _ois_depth "${_ois_depth} + 1")
        elseif(_ois_char STREQUAL "}")
            math(EXPR _ois_depth "${_ois_depth} - 1")
        endif()
        math(EXPR _ois_pos "${_ois_pos} + 1")
        if(_ois_depth EQUAL 0)
            break()
        endif()
    endwhile()
    if(NOT _ois_depth EQUAL 0)
        message(FATAL_ERROR "Unterminated production Cocoa method: ${method_name}")
    endif()
    math(EXPR _ois_body_len "${_ois_pos} - ${_ois_start}")
    string(SUBSTRING "${_ois_source}" ${_ois_start} ${_ois_body_len} _ois_body)
    set(${output_var} "${_ois_body}" PARENT_SCOPE)
endfunction()
