// Bounded production-fragment regression; see README.md for the test boundary.
#import <Foundation/Foundation.h>
#include "OISMouse.h"
#include <cstdio>

using OIS::MouseState;

// These names are replaced locally, never linked to CoreGraphics cursor APIs.
#define CGDisplayHideCursor(display) ((void)0)
#define CGAssociateMouseAndMouseCursorPosition(associate) ((void)0)

class CocoaMouse;
struct MouseEvent
{
	MouseEvent(CocoaMouse*, const MouseState& value) : state(value) {}
	const MouseState& state;
};

struct Listener
{
	int calls = 0;
	MouseState last;
	bool mouseMoved(const MouseEvent& event)
	{
		++calls;
		last = event.state;
		return true;
	}
};

class CocoaMouse
{
public:
	MouseState state;
	Listener listener;
	bool isBuffered = true;
	bool hasListener = true;
	CocoaMouse() { state.clear(); }
	MouseState* getMouseStatePtr() { return &state; }
	bool buffered() const { return isBuffered; }
	Listener* getEventCallback() { return hasListener ? &listener : 0; }
};

// Foundation objects carrying deterministic values; no AppKit classes are used.
@interface NSEvent : NSObject {
@public
	double x, y;
}
- (double)deltaX;
- (double)deltaY;
@end
@implementation NSEvent
- (double)deltaX { return x; }
- (double)deltaY { return y; }
@end

@interface FixtureWindow : NSObject
- (NSPoint)mouseLocationOutsideOfEventStream;
- (FixtureWindow*)contentView;
- (NSRect)frame;
@end
@implementation FixtureWindow
- (NSPoint)mouseLocationOutsideOfEventStream { return NSMakePoint(12.75, 4.75); }
- (FixtureWindow*)contentView { return self; }
- (NSRect)frame { return NSMakeRect(0, 0, 50, 40); }
@end

@interface MotionResponder : NSObject {
@public
@PRODUCTION_IVARS@
	FixtureWindow* testWindow;
}
- (void)capture;
- (void)mouseMoved:(NSEvent*)theEvent;
- (void)mouseDragged:(NSEvent*)theEvent;
- (void)rightMouseDragged:(NSEvent*)theEvent;
- (void)otherMouseDragged:(NSEvent*)theEvent;
- (void)scrollWheel:(NSEvent*)theEvent;
- (void)mouseEntered:(NSEvent*)theEvent;
- (FixtureWindow*)window;
@end
@implementation MotionResponder
- (FixtureWindow*)window { return testWindow; }
@PRODUCTION_METHODS@
@end

struct Fixture
{
	CocoaMouse mouse;
	MotionResponder* view;
	Fixture() : view([MotionResponder new])
	{
		view->oisMouseObj = &mouse;
		view->testWindow = [FixtureWindow new];
	}
	~Fixture()
	{
		[view->testWindow release];
		[view release];
	}
	void move(int handler, double x, double y)
	{
		NSEvent* event = [NSEvent new];
		event->x = x;
		event->y = y;
		switch(handler)
		{
		case 0: [view mouseMoved:event]; break;
		case 1: [view mouseDragged:event]; break;
		case 2: [view rightMouseDragged:event]; break;
		case 3: [view otherMouseDragged:event]; break;
		case 4: [view scrollWheel:event]; break;
		}
		[event release];
	}
	void capture() { [view capture]; }
};

static int checks = 0, failures = 0;
static void expect(const char* name, int actual, int expected)
{
	++checks;
	if(actual != expected)
	{
		++failures;
		std::fprintf(stderr, "%s: expected %d, got %d\n", name, expected, actual);
	}
}

int main()
{
	@autoreleasepool
	{
		for(int handler = 0; handler != 4; ++handler)
		{
			Fixture f;
			for(int i = 0; i != 4; ++i) f.move(handler, 0.25, -0.25);
			f.capture();
			expect("each handler accumulates positive subunits", f.mouse.state.X.rel, 1);
			expect("each handler accumulates negative subunits", f.mouse.state.Y.rel, -1);
			expect("one callback per capture", f.mouse.listener.calls, 1);
		}

		for(int sign = -1; sign <= 1; sign += 2)
		{
			Fixture f;
			for(int i = 0; i != 3; ++i)
			{
				f.move(i, sign * 0.25, -sign * 0.25);
				f.capture();
				expect("fraction stays below one across capture", f.mouse.state.X.rel, 0);
				f.capture();
				expect("empty capture has no callback", f.mouse.listener.calls, 0);
			}
			f.move(3, sign * 0.25, -sign * 0.25);
			f.capture();
			expect("carry across captures and handlers X", f.mouse.state.X.rel, sign);
			expect("carry across captures and handlers Y", f.mouse.state.Y.rel, -sign);
			f.capture();
			expect("whole motion never repeats", f.mouse.state.X.rel, 0);
			expect("empty capture does not replay callback", f.mouse.listener.calls, 1);
		}

		for(int sign = -1; sign <= 1; sign += 2)
		{
			Fixture f;
			f.move(0, sign * 1.25, -sign * 1.25);
			f.move(1, -sign * 0.75, sign * 0.75);
			f.capture();
			expect("reversal aggregates before truncation", f.mouse.state.X.rel, 0);
			f.move(2, sign * 0.5, -sign * 0.5);
			f.capture();
			expect("reversed fraction remains available X", f.mouse.state.X.rel, sign);
			expect("reversed fraction remains available Y", f.mouse.state.Y.rel, -sign);
		}

		for(int sign = -1; sign <= 1; sign += 2)
		{
			Fixture f;
			f.move(0, sign * 1.25, -sign * 1.25);
			f.capture();
			expect("whole motion leaves signed remainder", f.mouse.state.X.rel, sign);
			f.move(1, -sign * 0.5, sign * 0.5);
			f.capture();
			expect("cross capture reversal cancels remainder", f.mouse.state.X.rel, 0);
			f.move(2, -sign * 0.75, sign * 0.75);
			f.capture();
			expect("cross capture reversal emits X", f.mouse.state.X.rel, -sign);
			expect("cross capture reversal emits Y", f.mouse.state.Y.rel, sign);
		}

		{
			Fixture f;
			f.move(0, 0.75, -0.25);
			f.move(1, 0.5, -0.5);
			f.move(2, -0.5, -0.75);
			f.move(3, 0.25, -0.5);
			f.capture();
			expect("mixed handler axes X", f.mouse.state.X.rel, 1);
			expect("mixed handler axes Y", f.mouse.state.Y.rel, -2);
		}

		for(int handler = 0; handler != 4; ++handler)
		{
			Fixture f;
			f.mouse.state.X.abs = 49;
			f.mouse.state.Y.abs = 1;
			f.mouse.state.buttons = 5;
			f.move(handler, 3, -2);
			f.move(4, 0, 0.5);
			f.capture();
			expect("integral motion X", f.mouse.state.X.rel, 3);
			expect("integral motion Y", f.mouse.state.Y.rel, -2);
			expect("upper absolute clamp", f.mouse.state.X.abs, 50);
			expect("lower absolute clamp", f.mouse.state.Y.abs, 0);
			expect("scroll relative unchanged", f.mouse.state.Z.rel, 30);
			expect("scroll absolute unchanged", f.mouse.state.Z.abs, 30);
			expect("buttons preserved by capture", f.mouse.state.buttons, 5);
			expect("callback sees integer motion", f.mouse.listener.last.X.rel, 3);
		}

		for(int handler = 0; handler != 4; ++handler)
		{
			Fixture f;
			f.move(0, 0.5, -0.5);
			f.capture();
			f.view->mMouseWarped = true;
			f.move(handler, 100.75, -100.75);
			expect("warp flag consumed", f.view->mMouseWarped, false);
			f.view->mNeedsToRegainFocus = true;
			f.move(handler, -100.25, 100.25);
			f.capture();
			expect("ignored events do not emit motion", f.mouse.listener.calls, 0);
			f.view->mNeedsToRegainFocus = false;
			f.move(handler, 0.5, -0.5);
			f.capture();
			expect("gates preserve genuine fraction X", f.mouse.state.X.rel, 1);
			expect("gates preserve genuine fraction Y", f.mouse.state.Y.rel, -1);
		}

		{
			Fixture f;
			f.move(0, 3.75, -2.75);
			[f.view mouseEntered:nil];
			f.capture();
			expect("entry replaces uncaptured whole motion X", f.mouse.state.X.abs, 12);
			expect("entry replaces uncaptured whole motion Y", f.mouse.state.Y.abs, 35);
		}

		{
			Fixture f;
			f.move(0, 0.75, -0.75);
			f.capture();
			[f.view mouseEntered:nil];
			f.capture();
			expect("entry seeds existing integer position X", f.mouse.state.X.abs, 12);
			expect("entry seeds existing integer position Y", f.mouse.state.Y.abs, 35);
			f.move(1, 0.5, -0.5);
			f.capture();
			expect("entry resets stale fraction X", f.mouse.state.X.rel, 0);
			expect("entry resets stale fraction Y", f.mouse.state.Y.rel, 0);
			f.move(2, 0.5, -0.5);
			f.capture();
			expect("new entry fraction accumulates X", f.mouse.state.X.rel, 1);
			expect("new entry fraction accumulates Y", f.mouse.state.Y.rel, -1);
		}

		{
			Fixture f;
			f.move(0, 0.75, -0.75);
			f.capture();
			f.view->mMouseWarped = true;
			[f.view mouseEntered:nil];
			f.move(1, 100, 100);
			f.move(2, 0.25, -0.25);
			f.capture();
			expect("ignored entry leaves genuine fraction X", f.mouse.state.X.rel, 1);
			expect("ignored entry leaves genuine fraction Y", f.mouse.state.Y.rel, -1);
		}

		for(int mode = 0; mode != 2; ++mode)
		{
			Fixture f;
			f.mouse.isBuffered = mode != 0;
			f.mouse.hasListener = mode == 0;
			f.move(0, 1.5, -1.5);
			f.capture();
			f.move(1, 0.5, -0.5);
			f.capture();
			expect("polled motion retains fraction", f.mouse.state.X.rel, 1);
			expect("buffer/listener gates preserved", f.mouse.listener.calls, 0);
		}
	}
	std::printf("Cocoa motion production fragments: %d checks, %d failures\n", checks, failures);
	return failures ? 1 : 0;
}
